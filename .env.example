# skuggi keeps its app config in configs/config.json (copy from
# configs/config.example.json; edit it with `config` inside skuggi). Only the
# items below belong in the environment, because they are secrets or env-only
# overrides. Export them into your shell (or `set -a && source .env`); skuggi no
# longer auto-loads a .env file.

# --- secrets (never stored in configs/config.json) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# The openai/chatgpt providers can also read ~/.codex/auth.json (codex login).

# --- env-only overrides ---
# OLLAMA_BASE_URL=http://localhost:11434
# Point at a different persisted config file (default ./configs/config.json):
# SKUGGI_CONFIG_PATH=./configs/config.json
# Any setting can also be overridden ad hoc, e.g. SKUGGI_PROVIDER=anthropic,
# and the env value wins over configs/config.json.
