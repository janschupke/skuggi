SKUGGI_PROVIDER=openai

# Model per provider. Defaults are the small/cheap tier of each provider's
# current lineup; override any of them freely.
SKUGGI_MODEL_OPENAI=gpt-6-luna
SKUGGI_MODEL_CHATGPT=gpt-6-luna
SKUGGI_MODEL_ANTHROPIC=claude-haiku-4-5
# Whatever you have pulled: `ollama pull qwen3`
SKUGGI_MODEL_OLLAMA=qwen3

SKUGGI_EMBEDDING_MODEL=text-embedding-3-small
SKUGGI_EMBEDDING_MODEL_OLLAMA=nomic-embed-text

SKUGGI_SQLITE_PATH=./data/sessions.db
SKUGGI_FAISS_PATH=./data/faiss_index
SKUGGI_HISTORY_PATH=./data/.repl_history

SKUGGI_MAX_REVISIONS=2
SKUGGI_MAX_TOOL_ROUNDS=4
SKUGGI_RETRIEVE_K=4
SKUGGI_CHUNK_SIZE=800
SKUGGI_CHUNK_OVERLAP=120

# Prior conversation the planner/worker/critic see, bounded by both:
SKUGGI_HISTORY_MESSAGES=8
SKUGGI_HISTORY_CHARS=4000

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434

# Codex / ChatGPT-account overrides (rarely needed)
# SKUGGI_CODEX_AUTH_PATH=~/.codex/auth.json
# SKUGGI_CODEX_RESPONSES_BASE=https://chatgpt.com/backend-api/codex
# SKUGGI_CODEX_REFRESH_URL=https://auth.openai.com/oauth/token

# --- pentest harness ---
# Operating mode selects the agent prompt set: pentest | redteam | blueteam
SKUGGI_MODE=pentest
# Harness config (shared across engagements), committed only as .example:
#   the recognized-tool registry and the optional workspace-layout override.
SKUGGI_REGISTRY_PATH=./configs/tools.json
SKUGGI_LAYOUT_PATH=./configs/layout.json
# Engagement setup lives in a per-engagement workspace under this root; the
# active engagement selects engagements/<name>/ (its scope.json, ledger and
# reports live inside). Leave SKUGGI_ENGAGEMENT unset to run agent-only.
SKUGGI_ENGAGEMENTS_DIR=./engagements
# SKUGGI_ENGAGEMENT=acme-external-2026
SKUGGI_MANAGED_TOOLS_DIR=./data/toolbox
# Where to find/install tools: host | managed | combine
SKUGGI_TOOL_SOURCE=combine
# Wall-clock cap (seconds) on any single autonomously executed command
SKUGGI_COMMAND_TIMEOUT_S=120
