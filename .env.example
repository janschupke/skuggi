SKUGGI_PROVIDER=openai
SKUGGI_MODEL_OPENAI=gpt-4o-mini
SKUGGI_MODEL_CHATGPT=gpt-5
SKUGGI_MODEL_ANTHROPIC=claude-sonnet-4-5-20250929
SKUGGI_MODEL_OLLAMA=llama3.2
SKUGGI_EMBEDDING_MODEL=text-embedding-3-small
SKUGGI_SQLITE_PATH=./data/sessions.db
SKUGGI_FAISS_PATH=./data/faiss_index
SKUGGI_MAX_REVISIONS=2

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434

# Codex endpoint overrides (rarely needed, for mocks/testing)
