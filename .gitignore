.venv/
data/
# ...but the vendored, version-pinned framework taxonomies are shipped package data,
# not a runtime home, so they ARE tracked.
!src/skuggi/frameworks/data/
.env
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
dist/
*.egg-info/
# Harness config now lives in the config home (~/.config/skuggi), and the
# templates ship inside the package at src/skuggi/templates/. A ./configs left in
# a checkout is pre-migration leftovers or a deliberate local override
# (SKUGGI_CONFIG_PATH=./configs/config.json); either way it holds live target
# data and is never committed.
configs/
# Per-engagement workspaces (scope.json, ledger, reports, recon output) are live
# engagement data -- never committed.
engagements/
