<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>CiviDoc — portal sign in</title>
</head>
<body>
    <h1>CiviDoc portal</h1>
    <h2>Sign in</h2>
    {% if error %}<p style="color:#b00">{{ error }}</p>{% endif %}
    <form method="post" action="{{ path('portal_login') }}">
        <p><label>Email <input name="email" type="email" autofocus></label></p>
        <p><label>Password <input name="password" type="password"></label></p>
        <p><button type="submit">Sign in</button></p>
    </form>
    <p><a href="{{ path('home') }}">&larr; back</a></p>
</body>
</html>
