<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TrackRails — project tracker</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; max-width: 60rem; }
    nav a { margin-right: 1rem; }
    table { border-collapse: collapse; }
    th, td { border: 1px solid #ccc; padding: 4px 8px; }
    .flash { padding: .5rem; background: #eef; border: 1px solid #99c; }
    .alert { background: #fee; border-color: #c99; }
    pre { background: #f4f4f4; padding: 1rem; overflow:auto; }
  </style>
</head>
<body>
  <nav>
    <a href="/">TrackRails</a>
    <a href="<%= users_path %>">Users</a>
    <a href="<%= notes_path %>">Notes</a>
    <% if logged_in? %>
      <span>— <%= current_user.email %> (<%= current_user.role %>)</span>
      <%= button_to "Sign out", logout_path, method: :delete %>
    <% else %>
      <a href="<%= login_path %>">Sign in</a>
      <a href="<%= signup_path %>">Sign up</a>
    <% end %>
  </nav>
  <% if notice %><p class="flash"><%= notice %></p><% end %>
  <% if alert %><p class="flash alert"><%= alert %></p><% end %>
  <%= yield %>
</body>
</html>
