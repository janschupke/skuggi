<h1>Team directory</h1>
<table>
  <tr><th>ID</th><th>Email</th><th>Name</th><th>Role</th><th></th></tr>
  <% @users.each do |u| %>
    <tr>
      <td><%= u.id %></td>
      <td><a href="<%= user_path(u) %>"><%= u.email %></a></td>
      <td><%= u.name %></td>
      <td><%= u.role %></td>
      <td><a href="<%= edit_user_path(u) %>">edit</a></td>
    </tr>
  <% end %>
</table>
