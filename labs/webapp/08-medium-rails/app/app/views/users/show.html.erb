<h1><%= @user.email %></h1>
<table>
  <tr><th>ID</th><td><%= @user.id %></td></tr>
  <tr><th>Email</th><td><%= @user.email %></td></tr>
  <tr><th>Name</th><td><%= @user.name %></td></tr>
  <tr><th>Role</th><td><%= @user.role %></td></tr>
</table>
<p><a href="<%= edit_user_path(@user) %>">Edit this profile</a></p>
<% if current_user&.admin? %><p><a href="/ops">Open ops panel</a></p><% end %>
