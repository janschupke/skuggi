<h1>Sign up</h1>
<%= form_with model: @user, url: users_path, method: :post, local: true do |f| %>
  <% if @user.errors.any? %>
    <ul><% @user.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
  <% end %>
  <p><%= f.label :email %> <%= f.email_field :email %></p>
  <p><%= f.label :name %> <%= f.text_field :name %></p>
  <p><%= f.label :password %> <%= f.password_field :password %></p>
  <p><button type="submit">Create account</button></p>
<% end %>
