# skuggi practice lab configuration. Copy to `.env`: `cp .env.example .env`
# These are LAB values. The DB credentials below are intentionally weak and are
# documented openly in docs/lab.md — this is a deliberately vulnerable target.

# Lab network. 192.0.2.0/24 is IANA TEST-NET-1 (reserved for documentation),
# so a stray route can never collide with real infrastructure. It also matches
# skuggi's packaged scope.example.json out of the box.
LAB_SUBNET=192.0.2.0/24

# Host-published ports — bound to 127.0.0.1 only.
WEB_HTTP_PORT=8080
WEB_MYSQL_PORT=3306

# WireGuard fallback gateway (macOS reachability overlay).
WG_PORT=51820
WG_PEERS=1
